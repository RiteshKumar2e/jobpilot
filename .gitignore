data/google_credentials.json
data/google_token.json
data/google_sheet_id.txt
data/browser_profile/
**/client_secret*.json
**/service_account*.json
*.pem
*.key

# ---- Candidate private data ----
data/resumes/*
!data/resumes/.gitkeep
data/tailored/*
!data/tailored/.gitkeep
data/logs/*
