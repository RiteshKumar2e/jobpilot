__pycache__/
*.py[cod]
.venv/
venv/
# portable Python runtime (run_backend.bat sets it up locally)
backend/.python/
.env.local
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# ---- OS ----
.DS_Store
Thumbs.db
