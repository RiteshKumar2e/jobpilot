# ============================================================================
# JOBPILOT AI — environment configuration (COPY to .env and fill in)
# NEVER commit the real .env. It is already in .gitignore.
# Every value here is a PLACEHOLDER. Do not paste real secrets into source.
# ============================================================================

# ---- App ----
JOBPILOT_ENV=dev
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=8077
# A shared secret the frontend sends as 'X-API-Key'. Generate a random string.
JOBPILOT_API_KEY=change-me-to-a-long-random-string
# Comma-separated allowed CORS origins (the Vite dev server)
JOBPILOT_CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177

# ---- Database ----
# SQLite by default. For Postgres later:
#   postgresql+psycopg://user:pass@localhost:5432/jobpilot
JOBPILOT_DB_URL=sqlite:///../data/jobpilot.db

# ---- Paths ----
JOBPILOT_PROFILE_PATH=../data/profile/candidate_profile.yaml
JOBPILOT_RESUMES_DIR=../data/resumes
JOBPILOT_TAILORED_DIR=../data/tailored
JOBPILOT_LOG_DIR=../data/logs

# ---- Approval / safety ----
# SAFE (Mode A, default): never auto-submits; everything stops for your review.
# RESTRICTED_AUTO (Mode B): only the sources you explicitly list may auto-submit.
JOBPILOT_APPROVAL_MODE=SAFE
# Even in Mode B, only these greenhouse boards / lever accounts may auto-submit.
JOBPILOT_AUTO_APPLY_ALLOWLIST=
# Max applications prepared per day (a hard safety cap)
JOBPILOT_DAILY_APPLICATION_LIMIT=15
# Max NEW drafts auto-submitted per day in Mode B (separate, smaller cap)
JOBPILOT_DAILY_AUTOSUBMIT_LIMIT=0

# ---- Discovery ----
JOBPILOT_DISCOVERY_CRON=0 */6 * * *     # every 6 hours (APScheduler cron)
# Run a full cycle (apply queued jobs, discover, sync Sheets) right after start-up
JOBPILOT_RUN_ON_STARTUP=true
JOBPILOT_HTTP_TIMEOUT=20
JOBPILOT_MAX_CONCURRENCY=4

# ---- LLM provider abstraction ----
# One of: none | groq | gemini
#   none      -> deterministic rule-based tailoring (no API, no cost). Works fully.
#   groq      -> FREE tier. Key: https://console.groq.com/keys      -> GROQ_API_KEY
#   gemini    -> FREE tier. Key: https://aistudio.google.com/apikey -> GEMINI_API_KEY
# If a free-tier call fails (rate limit etc.) that item falls back to rule-based.
JOBPILOT_LLM_PROVIDER=none
GROQ_API_KEY=
JOBPILOT_GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
JOBPILOT_GEMINI_MODEL=gemini-2.5-flash

# ---- Google Sheets (official API) ----
# Path to the OAuth client secrets or service-account JSON you download from
# Google Cloud Console. See docs/SETUP_WINDOWS.md.
JOBPILOT_GOOGLE_CREDENTIALS=../data/google_credentials.json
JOBPILOT_GOOGLE_TOKEN=../data/google_token.json
# Leave blank to have the app create a new sheet on first run, then paste its ID.
JOBPILOT_SHEET_ID=

# ---- Browser automation ----
# Persistent Playwright profile dir (keeps you logged in between runs; private)
JOBPILOT_BROWSER_PROFILE_DIR=../data/browser_profile
# headful lets you watch/intervene; headless for unattended Mode B
JOBPILOT_BROWSER_HEADLESS=false

# ---- Auto-apply + email notifications ----
# Mode B only auto-submits jobs scoring at least this much.
JOBPILOT_MIN_AUTOSUBMIT_SCORE=55
# Where "Applied: ..." and "needs you" emails go.
JOBPILOT_NOTIFY_EMAIL=
# Gmail sender. SMTP_PASSWORD must be a Gmail *App Password* (16 letters) from
# https://myaccount.google.com/apppasswords — needs 2-Step Verification on.
JOBPILOT_SMTP_HOST=smtp.gmail.com
JOBPILOT_SMTP_PORT=465
JOBPILOT_SMTP_USER=
JOBPILOT_SMTP_PASSWORD=
